# Copy to .env.local for local development. Never commit real secrets.

# Vercel deploy hook, optional for manual deployment triggers
VERCEL_DEPLOY_HOOK_URL=""

# Neon / Postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

PGHOST=""
PGHOST_UNPOOLED=""
PGUSER=""
PGDATABASE=""
PGPASSWORD=""

# Vercel Postgres-compatible names
POSTGRES_URL="postgresql://USER:PASSWORD@HOST/DATABASE?channel_binding=require&sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST/DATABASE?channel_binding=require&sslmode=require"
POSTGRES_USER=""
POSTGRES_HOST=""
POSTGRES_PASSWORD=""
POSTGRES_DATABASE=""
POSTGRES_URL_NO_SSL="postgresql://USER:PASSWORD@HOST/DATABASE"
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST/DATABASE?channel_binding=require&connect_timeout=15&sslmode=require"
