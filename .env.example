# Copy to .env.local for local development. Never commit real secrets.

# Vercel deploy hook, optional for manual deployment triggers
VERCEL_DEPLOY_HOOK_URL=""

# Neon / Postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

PGHOST=""
PGHOST_UNPOOLED=""
PGUSER=""
PGDATABASE=""
PGPASSWORD=""

# Vercel Postgres-compatible names
POSTGRES_URL="postgresql://USER:PASSWORD@HOST/DATABASE?channel_binding=require&sslmode=require"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST/DATABASE?channel_binding=require&sslmode=require"
POSTGRES_USER=""
POSTGRES_HOST=""
POSTGRES_PASSWORD=""
POSTGRES_DATABASE=""
POSTGRES_URL_NO_SSL="postgresql://USER:***@HOST/DATABASE"
POSTGRES_PRISMA_URL="postgresql://USER:***@HOST/DATABASE?channel_binding=require&connect_timeout=15&sslmode=require"

# Waitlist confirmation email via Resend
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Éclat de Noor <waitlist@example.com>"
RESEND_REPLY_TO_EMAIL="kontakt@example.com"

# Consent-gated analytics / marketing scripts
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="eclatdenoor.vercel.app"
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL="https://plausible.io/js/script.js"
NEXT_PUBLIC_MARKETING_SCRIPT_URL=""
NEXT_PUBLIC_MARKETING_SCRIPT_ID=""
